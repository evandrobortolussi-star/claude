# Create a project at https://supabase.com, then copy these from
# Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"

# Service role key: server-only, NEVER exposed to the browser and NEVER
# committed. Used only for trusted server-side maintenance tasks (if any) —
# regular app requests must always go through the anon key + RLS.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Base URL of this app, used to build the password-reset redirect link.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
