# Firebase project config — from Firebase Console → Project settings →
# General → "Your apps" → the web app's config block. These are public by
# design (safe to ship to the browser), used only for Firebase Auth on the
# client — no Firestore data is ever read/written from the browser.
NEXT_PUBLIC_FIREBASE_API_KEY="your-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"

# Server-only credential for the Admin SDK (Firestore + session cookies).
# NEVER exposed to the browser and NEVER committed. Paste the full contents
# of the service account JSON file (Project settings → Service accounts →
# Generate new private key) as a single-line string. Leave unset when
# running on Firebase App Hosting itself — it picks up the attached service
# account automatically via Application Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY='{"type":"service_account",...}'

# Base URL of this app, used to build the password-reset redirect link.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
